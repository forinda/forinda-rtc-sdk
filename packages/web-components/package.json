{
  "name": "@forinda/video-sdk-elements",
  "version": "0.0.0",
  "description": "Web Components (custom HTML elements) for the Forinda video SDK",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manual": {
      "types": "./dist/manual.d.ts",
      "import": "./dist/manual.js"
    },
    "./global": "./dist/index.global.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "lint": "wireit"
  },
  "devDependencies": {
    "@forinda/video-sdk-core": "workspace:*",
    "oxlint": "^0.11.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0",
    "wireit": "^0.14.9"
  },
  "peerDependencies": {
    "@forinda/video-sdk-core": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "wireit": {
    "build": {
      "command": "tsup",
      "files": [
        "src/**/*.ts",
        "tsup.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../core:build"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": []
    },
    "lint": {
      "command": "oxlint src",
      "files": [
        "src/**/*.ts",
        "../../oxlint.json"
      ],
      "output": []
    }
  }
}
