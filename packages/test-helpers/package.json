{
  "name": "@forinda/test-helpers",
  "version": "0.0.0",
  "private": true,
  "description": "Internal test helpers for the Forinda video SDK monorepo (not published)",
  "keywords": [
    "fixtures",
    "internal",
    "sdk",
    "test",
    "webrtc"
  ],
  "homepage": "https://github.com/forinda/forinda-rtc-sdk#readme",
  "bugs": {
    "url": "https://github.com/forinda/forinda-rtc-sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Felix Orinda",
    "email": "forinda82@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/forinda-rtc-sdk.git",
    "directory": "packages/test-helpers"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "lint": "wireit"
  },
  "devDependencies": {
    "oxlint": "^0.11.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0",
    "wireit": "^0.14.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "wireit": {
    "build": {
      "command": "tsup",
      "files": [
        "src/**/*.ts",
        "tsup.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": []
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": []
    },
    "lint": {
      "command": "oxlint src",
      "files": [
        "src/**/*.ts",
        "../../oxlint.json"
      ],
      "output": []
    }
  }
}
