{
  "name": "@forinda/video-sdk-signaling-broadcast",
  "version": "0.0.0",
  "description": "Same-tab BroadcastChannel client transport for Forinda video SDK demos and tests",
  "keywords": [
    "broadcastchannel",
    "browser",
    "client",
    "sdk",
    "signaling",
    "webrtc"
  ],
  "homepage": "https://github.com/forinda/forinda-rtc-sdk#readme",
  "bugs": {
    "url": "https://github.com/forinda/forinda-rtc-sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Felix Orinda",
    "email": "forinda82@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/forinda-rtc-sdk.git",
    "directory": "packages/signaling-broadcast"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "lint": "wireit"
  },
  "devDependencies": {
    "oxlint": "^0.11.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0",
    "wireit": "^0.14.9"
  },
  "peerDependencies": {
    "@forinda/video-sdk-core": "workspace:*",
    "@forinda/video-sdk-signaling-protocol": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "wireit": {
    "build": {
      "command": "tsup",
      "files": [
        "src/**/*.ts",
        "tsup.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted"
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": []
    },
    "lint": {
      "command": "oxlint src",
      "files": [
        "src/**/*.ts",
        "../../oxlint.json"
      ],
      "output": []
    }
  }
}
