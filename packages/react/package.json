{
  "name": "@forinda/video-sdk-react",
  "version": "0.1.0",
  "description": "React hooks and components for the Forinda video SDK",
  "keywords": [
    "components",
    "hooks",
    "react",
    "sdk",
    "video",
    "webrtc"
  ],
  "homepage": "https://github.com/forinda/forinda-rtc-sdk#readme",
  "bugs": {
    "url": "https://github.com/forinda/forinda-rtc-sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Felix Orinda",
    "email": "forinda82@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/forinda-rtc-sdk.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@forinda/test-helpers": "workspace:*",
    "@forinda/video-sdk-core": "workspace:*",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "oxlint": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0",
    "vitest": "^2.1.0",
    "wireit": "^0.14.9"
  },
  "peerDependencies": {
    "@forinda/video-sdk-core": "workspace:*",
    "react": ">=18.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "wireit": {
    "build": {
      "command": "tsup",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsup.config.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../core:build"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": []
    },
    "lint": {
      "command": "oxlint src",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "../../oxlint.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
        "vitest.config.ts",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": []
    }
  }
}
