{
  "name": "dev-signaling-server",
  "version": "0.0.0",
  "private": true,
  "description": "Local development signaling server for Forinda video SDK examples and tests",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "lint": "wireit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "wireit": {
    "build": {
      "command": "tsup",
      "files": ["src/**/*.ts", "tsup.config.ts", "tsconfig.json", "../../tsconfig.base.json"],
      "output": ["dist/**"],
      "clean": "if-file-deleted",
      "dependencies": ["../../packages/signaling-server:build"]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": ["src/**/*.ts", "tsconfig.json", "../../tsconfig.base.json"],
      "output": []
    },
    "lint": {
      "command": "oxlint src",
      "files": ["src/**/*.ts", "../../oxlint.json"],
      "output": []
    }
  },
  "dependencies": {
    "@forinda/video-sdk-signaling-server": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0",
    "wireit": "^0.14.9",
    "oxlint": "^0.11.0"
  }
}
